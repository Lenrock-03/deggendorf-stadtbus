# Client-Secret aus developers.deutschebahn.com (Anwendung anlegen, "Timetables"-Produkt
# abonnieren, Client-ID + Secret werden beim Anlegen einmalig angezeigt).
# Kopieren nach .env (nicht committen!) und mit den echten Werten befüllen.
DB_CLIENT_ID=
DB_API_KEY=
PORT=3000

# Für lokale Entwicklung ohne Docker: zeigt auf einen lokal laufenden Motis-Server (z.B.
# `./motis server` direkt gestartet, siehe motis/README.md). In Docker setzt
# docker-compose.yml stattdessen MOTIS_URL=http://motis:8080 automatisch.
MOTIS_URL=http://localhost:8093
